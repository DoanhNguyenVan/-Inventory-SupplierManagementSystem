				{
					"name": "Register New Account",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Registration returns success true\", function () {",
									"    var res = pm.response.json();",
									"    pm.expect(res.success).to.eql(true);",
									"    pm.expect(res.data).to.have.property(\"userId\");",
									"    pm.expect(res.data.username).to.eql(\"teststaff\");",
									"    pm.environment.set(\"created_user_id\", res.data.userId);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"teststaff\",\n    \"password\": \"staff123\",\n    \"fullName\": \"Test Staff Member\",\n    \"email\": \"teststaff@isms.com\"\n}"
